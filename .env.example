# Hugging Face Serverless Inference Endpoint (optional)
# Set up paid endpoint at: https://huggingface.co/settings/inference
VITE_HF_ENDPOINT=https://your-endpoint.huggingface.cloud
VITE_HF_TOKEN=hf_YOUR_TOKEN_HERE

# OR use Replicate API (free, easier setup)
# Get token from: https://replicate.com/account
VITE_REPLICATE_TOKEN=r8_YOUR_TOKEN_HERE

# Without any token, app uses offline client-side analysis
