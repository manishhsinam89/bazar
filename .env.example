# Supabase (required – shared product database)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# AI Analysis – Hugging Face (optional, used by /api/analyze serverless function)
VITE_HF_TOKEN=hf_YOUR_TOKEN_HERE

# AI Analysis – Google Gemini (optional fallback)
VITE_GEMINI_API_KEY=your_gemini_key_here

# Ollama local AI – configure URL in Settings page (no env var needed)
